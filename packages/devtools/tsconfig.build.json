{
  // Emit profile: compile `src/` to `dist/` as runnable ESM `.js` + `.d.ts` (what we publish).
  // Mirrors the other @rindle/* packages — `rewriteRelativeImportExtensions` rewrites `./x.ts`
  // specifiers to `./x.js` in the output; tests are excluded.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "rootDir": "./src",
    "outDir": "./dist",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "rewriteRelativeImportExtensions": true
  },
  "include": ["src"]
}
