{
  "name": "@rindle/optimistic",
  "version": "0.0.0",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rindle-sh/rindle.git",
    "directory": "packages/optimistic"
  },
  "type": "module",
  "description": "Optimistic-writes client glue: named client mutators + the fork/rebase loop (pending re-invocation, cv-buffered coherent release) over the wasm engine (OPTIMISTIC-WRITES-DESIGN.md).",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "@rindle/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "tsc --noEmit && node --conditions=@rindle/source --test test/*.test.ts && node --conditions=@rindle/source test/e2e.mjs"
  },
  "dependencies": {
    "@rindle/client": "workspace:*",
    "@rindle/normalized": "workspace:*",
    "@rindle/remote": "workspace:*",
    "@rindle/wasm": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0",
    "@rindle/narrator": "workspace:*",
    "@rindle/replica": "workspace:*"
  }
}
