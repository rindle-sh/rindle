{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "verbatimModuleSyntax": true,
    "allowImportingTsExtensions": true,
    // Depends on @rindle/client for the wire `Ast` type; resolve it from source (build-free).
    "customConditions": ["@rindle/source"],
    "types": ["node"]
  },
  "include": ["src", "test"]
}
