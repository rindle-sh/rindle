{
  // Typecheck profile. No DOM lib — this is a Node-only launcher. No `customConditions`: the
  // package imports nothing from the other @rindle/* packages, only `node:` builtins.
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "verbatimModuleSyntax": true,
    "allowImportingTsExtensions": true,
    "types": ["node"]
  },
  "include": ["src", "test"]
}
