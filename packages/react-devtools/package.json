{
  "name": "@rindle/react-devtools",
  "version": "0.0.0",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rindle-sh/rindle.git",
    "directory": "packages/react-devtools"
  },
  "type": "module",
  "description": "React floating panel for the Rindle in-browser devtools: mutation timeline, queries inspector, delta stream over @rindle/devtools (DEBUG-TOOLS-BROWSER-DESIGN.md). Dev-only; tree-shakes out of production.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "@rindle/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "tsc --noEmit && node --conditions=@rindle/source --test test/*.test.ts"
  },
  "dependencies": {
    "@rindle/devtools": "workspace:*"
  },
  "peerDependencies": {
    "react": ">=18.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/jsdom": "^21.1.0",
    "jsdom": "^25.0.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "typescript": "^5.7.0"
  }
}
