{
  "name": "@rindle/tanstack",
  "version": "0.0.0",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rindle-sh/rindle.git",
    "directory": "packages/tanstack"
  },
  "type": "module",
  "description": "TanStack Router integration for Rindle route preloading and SSR hydration.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "@rindle/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "tsc --noEmit && node --conditions=@rindle/source --test test/*.test.ts"
  },
  "dependencies": {
    "@rindle/client": "workspace:*",
    "@rindle/react": "workspace:*"
  },
  "peerDependencies": {
    "@tanstack/react-router": ">=1.167.0",
    "react": ">=18.0.0"
  },
  "devDependencies": {
    "@tanstack/react-router": "1.170.18",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "react": "^19.1.0",
    "typescript": "^5.7.0"
  }
}
