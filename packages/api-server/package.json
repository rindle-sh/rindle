{
  "name": "@rindle/api-server",
  "version": "0.0.0",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rindle-sh/rindle.git",
    "directory": "packages/api-server"
  },
  "type": "module",
  "description": "Application API-server helpers for Rindle query leases and custom mutator routing.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "@rindle/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "tsc --noEmit && node --conditions=@rindle/source --test test/*.test.ts",
    "test:rust-daemon": "node --conditions=@rindle/source test/session.e2e.mjs"
  },
  "dependencies": {
    "@rindle/client": "workspace:*",
    "@rindle/daemon-client": "workspace:*",
    "@rindle/query-compiler": "workspace:*",
    "@rindle/sql-client": "workspace:*"
  },
  "optionalDependencies": {
    "@rindle/room": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0"
  }
}
